services:
  db:
    image: postgres:16
    container_name: tai-runtime-postgres
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "127.0.0.1:{{ runtime_database_port }}:5432"
    volumes:
      - runtime-postgres-data:/var/lib/postgresql/data
    networks:
      - runtime
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 20

volumes:
  runtime-postgres-data:

networks:
  runtime:
    name: tai-runtime
