services:
  db:
    image: {{ frappe_postgres_image | to_json }}
    restart: unless-stopped
{% if not frappe_manage_postgres | bool %}
    profiles:
      - local-database
{% endif %}
  redis-cache:
    image: {{ frappe_redis_image | to_json }}
  redis-queue:
    image: {{ frappe_redis_image | to_json }}
  configurator:
    environment:
      DB_HOST: {{ frappe_db_host | to_json }}
      DB_PORT: {{ frappe_db_port | string | to_json }}
{% if not frappe_manage_postgres | bool %}
    depends_on:
      db:
        condition: service_healthy
        required: false
{% endif %}
  backend:
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
{% if frappe_secret_files %}
    labels:
      tai.deploy.secrets-checksum: {{ (frappe_secret_files | to_json | hash('sha256')) | to_json }}
    volumes:
{% for name in frappe_secret_files %}
      - {{ (secrets_root ~ '/' ~ name ~ ':/run/secrets/' ~ name ~ ':ro') | to_json }}
{% endfor %}
{% endif %}
  frontend:
    ports:
{% for address in frappe_bind_addresses %}
      - {{ (address ~ ':' ~ frappe_http_port ~ ':8080') | to_json }}
{% endfor %}
  websocket:
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
  queue-short:
    command: bench worker --queue {{ frappe_queue_short_queues | to_json }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
{% if frappe_secret_files %}
    labels:
      tai.deploy.secrets-checksum: {{ (frappe_secret_files | to_json | hash('sha256')) | to_json }}
    volumes:
{% for name in frappe_secret_files %}
      - {{ (secrets_root ~ '/' ~ name ~ ':/run/secrets/' ~ name ~ ':ro') | to_json }}
{% endfor %}
{% endif %}
  queue-long:
    command: bench worker --queue {{ frappe_queue_long_queues | to_json }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
{% if frappe_secret_files %}
    labels:
      tai.deploy.secrets-checksum: {{ (frappe_secret_files | to_json | hash('sha256')) | to_json }}
    volumes:
{% for name in frappe_secret_files %}
      - {{ (secrets_root ~ '/' ~ name ~ ':/run/secrets/' ~ name ~ ':ro') | to_json }}
{% endfor %}
{% endif %}
{% if frappe_enable_delivery_watcher_queue | bool %}
  queue-delivery-watcher:
    image: {{ frappe_image | to_json }}
    pull_policy: {{ frappe_pull_policy | to_json }}
    restart: unless-stopped
    platform: linux/amd64
    command: bench worker --queue tai_delivery_watcher
    depends_on:
      configurator:
        condition: service_completed_successfully
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
{% if frappe_secret_files %}
    labels:
      tai.deploy.secrets-checksum: {{ (frappe_secret_files | to_json | hash('sha256')) | to_json }}
    volumes:
      - sites:/home/frappe/frappe-bench/sites
{% for name in frappe_secret_files %}
      - {{ (secrets_root ~ '/' ~ name ~ ':/run/secrets/' ~ name ~ ':ro') | to_json }}
{% endfor %}
{% else %}
    volumes:
      - sites:/home/frappe/frappe-bench/sites
{% endif %}
{% endif %}
  scheduler:
    environment:
      NO_PROXY: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
      no_proxy: {{ deployment_no_proxy | replace('\n', '') | replace(' ', '') | to_json }}
{% if frappe_secret_files %}
    labels:
      tai.deploy.secrets-checksum: {{ (frappe_secret_files | to_json | hash('sha256')) | to_json }}
    volumes:
{% for name in frappe_secret_files %}
      - {{ (secrets_root ~ '/' ~ name ~ ':/run/secrets/' ~ name ~ ':ro') | to_json }}
{% endfor %}
{% endif %}

networks:
  default:
    ipam:
      config:
        - subnet: {{ frappe_docker_subnet | to_json }}
